{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "{assets/**,admin/**,*.html,*.jpg,*.jpeg,*.png,*.mp4}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js?path=$1" },
    { "source": "/admin/auth/login", "destination": "/server.js?path=admin/auth/login" },
    { "source": "/admin/login", "destination": "/server.js?path=admin/login" }
  ]
}
