{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{src/**,server.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js?_apiPath=/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?_apiPath=/api/$1"
    }
  ]
}
