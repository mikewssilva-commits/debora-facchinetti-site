# ==============================================================================
# VARIÁVEIS DE AMBIENTE — DÉBORA FACCHINETTI (LIVROS & EDUCAÇÃO)
# ==============================================================================

# Supabase (Banco de Dados PostgreSQL e Autenticação)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=seu-supabase-service-key

# Servidor Node.js Express
PORT=3000
SITE_URL=http://localhost:3000
JWT_SECRET=seu-jwt-secret-aqui

# ==============================================================================
# MERCADO PAGO — INTEGRAÇÃO DE PAGAMENTOS
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# ==============================================================================

# 1. Access Token de Produção ou Teste (Obrigatório para transações)
MERCADOPAGO_ACCESS_TOKEN=seu-access-token-aqui

# 2. Public Key de Produção ou Teste (Utilizado no frontend)
MERCADOPAGO_PUBLIC_KEY=sua-public-key-aqui

# 3. Webhook Secret / Assinatura de Notificações (Opcional)
MERCADOPAGO_WEBHOOK_SECRET=seu-webhook-secret-aqui
