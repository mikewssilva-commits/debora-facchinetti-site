# ==============================================================================
# VARIÁVEIS DE AMBIENTE — DÉBORA FACCHINETTI (LIVROS & EDUCAÇÃO)
# ==============================================================================

# Supabase (Banco de Dados PostgreSQL e Autenticação)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Servidor Node.js Express
PORT=3000
SITE_URL=http://localhost:3000

# ==============================================================================
# MERCADO PAGO — INTEGRAÇÃO DE PAGAMENTOS
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# ==============================================================================

# 1. Access Token de Produção ou Teste (Obrigatório para transações)
# Começa normalmente com "APP_USR-..." (produção) ou "TEST-..." (testes)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-aqui

# 2. Public Key de Produção ou Teste (Utilizado no frontend se necessário)
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-aqui

# 3. Webhook Secret / Assinatura de Notificações (Opcional, mas recomendado)
# Configurado na aba "Webhooks" do painel de desenvolvedores do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=seu-webhook-secret-aqui
